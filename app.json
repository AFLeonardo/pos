{
  "expo": {
    "name": "kikis-pos",
    "slug": "kikis-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./src/icon.png"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
